# Supabase PostgreSQL Connection Strings
# 1. DATABASE_URL: Transaction Pooled connection (Port 6543) or Direct connection
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct connection (Port 5432) used for Prisma migrations and db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Auth Secret
JWT_SECRET="super-secret-jwt-key-change-in-production-cafeqr-2026"
JWT_EXPIRES_IN="7d"

# Server Settings
PORT=5000
NODE_ENV="development"

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"
